{
	"layout": "row",
	"padding": [8, 4],
	"gap": 8,
	"cross_align": "center",
	"main_align": "start",
	"scale_with_text": true,
	"children": [
		{ "id": "background", "type": "rect", "fill_parent": true, "fill": "button", "border": "button_border", "border_width": 2 },
		{ "id": "caption", "type": "label", "font_size": 16 },
		{ "id": "slider", "type": "widget", "widget": "slider", "grow": 1 },
		{ "id": "value", "type": "label", "font_size": 16 }
	]
}
