{
	"layout": "column",
	"size": [640, 0],
	"padding": [28, 28],
	"scale_with_text": true,
	"children": [
		{ "type": "rect", "fill_parent": true, "fill": "panel", "border": "panel_border", "border_width": 2 },
		{ "id": "title", "type": "label", "font_size": 40, "decorative": true, "text_color": "accent", "shrink": true },
		{ "id": "message_gap", "type": "spacer", "size": [0, 20] },
		{ "id": "message", "type": "label", "font_size": 22, "wrap": true },
		{ "type": "spacer", "size": [0, 24] },
		{ "id": "buttons", "type": "widget", "widget": "overlay_buttons" }
	]
}
